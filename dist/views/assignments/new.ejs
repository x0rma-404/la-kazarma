<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1>New Assignment</h1>
    </div>

    <div class="card">
      <div class="card-body">
        <form action="/assignments/new" method="POST" enctype="multipart/form-data" class="auth-form">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required placeholder="Assignment title">
          </div>
          <div class="form-group">
            <label for="subject_id">Subject</label>
            <select id="subject_id" name="subject_id" required>
              <option value="">Select a subject</option>
              <% subjects.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.name %><% if (s.code) { %> (<%= s.code %>)<% } %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" placeholder="Assignment details and instructions"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="deadline_date">Due Date</label>
              <input type="date" id="deadline_date" name="deadline_date">
            </div>
            <div class="form-group">
              <label for="deadline_time">Due Time</label>
              <input type="time" id="deadline_time" name="deadline_time" value="23:59">
            </div>
          </div>
          <div class="form-group">
            <label for="tags">Tags</label>
            <input type="text" id="tags" name="tags" placeholder="Comma-separated tags (optional)">
          </div>
          <div class="form-group">
            <label for="file">Attach Specification File (optional)</label>
            <input type="file" id="file" name="file">
          </div>
          <div class="form-actions">
            <a href="/assignments" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create Assignment</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
