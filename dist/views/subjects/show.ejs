<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <div>
        <h1><%= subject.name %></h1>
        <p class="page-subtitle">
          <% if (subject.code) { %><span class="badge"><%= subject.code %></span><% } %>
          <% if (subject.semester) { %> Semester <%= subject.semester %><% } %>
          <% if (subject.academic_year) { %> - <%= subject.academic_year %><% } %>
        </p>
      </div>
      <div class="page-header-actions">
        <a href="/materials/upload?subject_id=<%= subject.id %>" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Upload Material
        </a>
        <a href="/assignments/new" class="btn btn-secondary">New Assignment</a>
      </div>
    </div>

    <% if (subject.description) { %>
      <div class="card">
        <div class="card-body">
          <p><%= subject.description %></p>
        </div>
      </div>
    <% } %>

    <div class="tabs">
      <button class="tab active" data-tab="materials">Materials</button>
      <button class="tab" data-tab="assignments">Assignments</button>
      <button class="tab" data-tab="topics">Topics</button>
      <button class="tab" data-tab="announcements">Announcements</button>
    </div>

    <div class="tab-content active" id="tab-materials">
      <% if (materials.length === 0) { %>
        <p class="empty-state">No materials for this subject yet.</p>
      <% } else { %>
        <div class="materials-list">
          <% materials.forEach(function(m) { %>
            <a href="/materials/<%= m.id %>" class="material-row">
              <div class="material-row-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div class="material-row-info">
                <strong><%= m.title %></strong>
                <span><%= m.file_type ? m.file_type.toUpperCase() : '' %><% if (m.uploader) { %> - Uploaded by <%= m.uploader.name %><% } %></span>
              </div>
              <span class="material-row-date"><%= new Date(m.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="tab-content" id="tab-assignments">
      <% if (assignments.length === 0) { %>
        <p class="empty-state">No assignments for this subject yet.</p>
      <% } else { %>
        <div class="materials-list">
          <% assignments.forEach(function(a) { %>
            <a href="/assignments/<%= a.id %>" class="material-row">
              <div class="material-row-icon material-row-icon-amber">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div class="material-row-info">
                <strong><%= a.title %></strong>
                <span>Due: <%= a.due_date ? new Date(a.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'No deadline' %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="tab-content" id="tab-topics">
      <div class="topics-section">
        <form action="/subjects/<%= subject.id %>/topics" method="POST" class="inline-form">
          <input type="text" name="name" placeholder="Topic name" required>
          <input type="text" name="description" placeholder="Description (optional)">
          <input type="number" name="order_index" placeholder="Order" min="0" value="0" style="width:80px">
          <button type="submit" class="btn btn-primary">Add Topic</button>
        </form>

        <% if (subject.topics && subject.topics.length > 0) { %>
          <div class="topics-list">
            <% subject.topics.forEach(function(t) { %>
              <div class="topic-row">
                <div>
                  <strong><%= t.name %></strong>
                  <% if (t.description) { %><p><%= t.description %></p><% } %>
                </div>
                <form action="/subjects/<%= subject.id %>/topics/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete this topic?')">
                  <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="empty-state">No topics added yet.</p>
        <% } %>
      </div>
    </div>

    <div class="tab-content" id="tab-announcements">
      <div class="topics-section">
        <% if (user.role === 'admin') { %>
          <form action="/subjects/<%= subject.id %>/announcements" method="POST" class="auth-form" style="max-width:600px">
            <div class="form-group">
              <label>Title</label>
              <input type="text" name="title" placeholder="Announcement title" required>
            </div>
            <div class="form-group">
              <label>Content</label>
              <textarea name="content" rows="3" placeholder="Announcement content"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Post Announcement</button>
          </form>
        <% } %>

        <% if (subject.announcements && subject.announcements.length > 0) { %>
          <div class="topics-list">
            <% subject.announcements.forEach(function(a) { %>
              <div class="topic-row">
                <div>
                  <strong><%= a.title %></strong>
                  <p><%= a.content %></p>
                  <span class="text-muted">Posted by <%= a.created_by_user ? a.created_by_user.name : 'Admin' %> on <%= new Date(a.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                <% if (user.role === 'admin') { %>
                  <form action="/subjects/<%= subject.id %>/announcements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this announcement?')">
                    <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="empty-state">No announcements yet.</p>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="/js/sidebar.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
