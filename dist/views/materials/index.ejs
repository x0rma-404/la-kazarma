<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <div>
        <h1>Materials</h1>
        <p class="page-subtitle">All study materials across subjects</p>
      </div>
      <a href="/materials/upload" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Upload
      </a>
    </div>

    <% if (materials.length === 0) { %>
      <div class="empty-state-card">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <h3>No materials yet</h3>
        <p>Upload study materials to share with the group.</p>
        <a href="/materials/upload" class="btn btn-primary">Upload Material</a>
      </div>
    <% } else { %>
      <div class="materials-list">
        <% materials.forEach(function(m) { %>
          <a href="/materials/<%= m.id %>" class="material-row">
            <div class="material-row-icon <%= bookmarkedIds.includes(m.id) ? 'material-row-icon-gold' : '' %>">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="material-row-info">
              <strong><%= m.title %></strong>
              <span>
                <%= m.subject ? m.subject.name : '' %>
                <% if (m.topic) { %> - <%= m.topic.name %><% } %>
                <% if (m.file_type) { %> - <%= m.file_type.toUpperCase() %><% } %>
              </span>
            </div>
            <span class="material-row-date"><%= new Date(m.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
