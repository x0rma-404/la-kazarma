<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1>Bookmarks</h1>
      <p class="page-subtitle">Your saved materials</p>
    </div>

    <% if (bookmarks.length === 0) { %>
      <div class="empty-state-card">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <h3>No bookmarks yet</h3>
        <p>Save materials for quick access by bookmarking them.</p>
        <a href="/materials" class="btn btn-primary">Browse Materials</a>
      </div>
    <% } else { %>
      <div class="materials-list">
        <% bookmarks.forEach(function(b) { %>
          <div class="material-row">
            <a href="/materials/<%= b.material ? b.material.id : '' %>" class="material-row-main">
              <div class="material-row-icon material-row-icon-gold">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div class="material-row-info">
                <strong><%= b.material ? b.material.title : '' %></strong>
                <span><%= b.material && b.material.subject ? b.material.subject.name : '' %></span>
              </div>
            </a>
            <form action="/bookmarks/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Remove this bookmark?')">
              <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
