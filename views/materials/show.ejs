<%- include('../partials/head') %>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/mobile-nav') %>

  <main class="main-content">
    <%- include('../partials/flash') %>

    <!-- Back button & actions -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
      <a href="/materials" class="btn btn-ghost btn-sm">← Back to Materials</a>
      <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap">
        <form method="POST" action="/materials/<%= material.id %>/bookmark" style="margin:0">
          <button type="submit" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:0.4rem">
            <%= material.is_bookmarked ? '🔖 Bookmarked' : '🏷 Bookmark' %>
          </button>
        </form>
        <a href="/materials/<%= material.id %>/download" class="btn btn-primary btn-sm" style="display:inline-flex;align-items:center;gap:0.4rem">
          ⬇ Download (<%= formatBytes(material.file_size) %>)
        </a>
        <% if (canEdit) { %>
          <button class="btn btn-ghost btn-sm" onclick="document.getElementById('edit-material-modal').classList.remove('hidden')">
            ⚙ Edit
          </button>
          <form method="POST" action="/materials/<%= material.id %>/delete" onsubmit="return confirm('Permanently delete \'<%= material.title %>\'?')" style="margin:0">
            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)">
              🗑 Delete
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Main 2-column Layout: Preview & Metadata -->
    <div style="display:grid;grid-template-columns:1fr 340px;gap:1.5rem;align-items:start">
      <!-- Left: File Preview / Details -->
      <div>
        <div class="card" style="margin-bottom:1.5rem">
          <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.75rem;flex-wrap:wrap">
            <span class="badge badge-student"><%= material.category %></span>
            <span class="badge badge-outline" style="text-transform:uppercase"><%= material.file_type %></span>
            <span class="badge badge-outline"><%= formatBytes(material.file_size) %></span>
            <span style="font-size:0.8rem;color:var(--text-muted)">
              Uploaded <%= new Date(material.created_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' }) %>
            </span>
          </div>

          <h1 style="font-size:1.6rem;margin:0 0 0.75rem;color:var(--text-heading)"><%= material.title %></h1>

          <% if (material.description) { %>
            <div style="background:rgba(255,255,255,0.02);padding:1rem;border-radius:var(--radius);border:1px solid var(--border);color:var(--text-primary);font-size:0.92rem;line-height:1.6;margin-bottom:1rem;white-space:pre-wrap">
              <%= material.description %>
            </div>
          <% } %>

          <% if (material.tags) { %>
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem">
              <% material.tags.split(',').forEach(tag => { %>
                <% if (tag.trim()) { %>
                  <span class="badge badge-student" style="font-size:0.75rem">#<%= tag.trim() %></span>
                <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- Document Preview Card -->
        <div class="card" style="padding:1rem">
          <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
            <h3>👁 Document Preview</h3>
            <a href="/materials/<%= material.id %>/download" class="btn btn-ghost btn-sm">Direct Download ⬇</a>
          </div>

          <% if (material.file_type === 'pdf') { %>
            <div style="position:relative;width:100%;height:680px;background:#1a1a1a;border-radius:var(--radius);overflow:hidden">
              <iframe src="/materials/<%= material.id %>/preview" style="width:100%;height:100%;border:none" title="<%= material.title %>"></iframe>
            </div>
          <% } else if (['png', 'jpg', 'jpeg', 'webp'].includes(material.file_type)) { %>
            <div style="text-align:center;background:#111;padding:1rem;border-radius:var(--radius)">
              <img src="/materials/<%= material.id %>/preview" alt="<%= material.title %>" style="max-width:100%;max-height:600px;border-radius:var(--radius);box-shadow:0 4px 16px rgba(0,0,0,0.4)">
            </div>
          <% } else if (material.file_type === 'txt') { %>
            <iframe src="/materials/<%= material.id %>/preview" style="width:100%;height:400px;border:1px solid var(--border);background:#111;color:#eee;border-radius:var(--radius)"></iframe>
          <% } else { %>
            <!-- Non-inline previewable files (DOC, DOCX, PPT, PPTX, XLS, XLSX, ZIP) -->
            <div style="text-align:center;padding:3rem 1.5rem;background:rgba(255,255,255,0.015);border-radius:var(--radius);border:1px dashed var(--border)">
              <span style="font-size:3.5rem;display:block;margin-bottom:0.75rem">📄</span>
              <h4 style="color:var(--text-heading);margin-bottom:0.35rem"><%= material.original_name %></h4>
              <p style="color:var(--text-muted);font-size:0.875rem;max-width:440px;margin:0 auto 1.25rem">
                Inline browser preview is not supported for <strong>.<%= material.file_type.toUpperCase() %></strong> documents. Download the file to view it in your desktop suite.
              </p>
              <a href="/materials/<%= material.id %>/download" class="btn btn-primary">
                Download File (<%= formatBytes(material.file_size) %>)
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right: Subject & Uploader Details Sidebar -->
      <div style="display:flex;flex-direction:column;gap:1.25rem">
        <!-- Subject Info -->
        <div class="card">
          <div class="card-header">
            <h3>🏛 Academic Context</h3>
          </div>
          <div style="font-size:0.875rem">
            <div style="margin-bottom:0.75rem">
              <span style="color:var(--text-muted);font-size:0.78rem;text-transform:uppercase">Subject</span>
              <div style="font-weight:600;color:var(--text-heading);margin-top:0.2rem">
                <a href="/subjects/<%= material.subject_id %>" style="color:var(--accent-light);text-decoration:none">
                  <%= material.subject_code ? material.subject_code + ' – ' : '' %><%= material.subject_name %>
                </a>
              </div>
            </div>

            <div style="margin-bottom:0.75rem">
              <span style="color:var(--text-muted);font-size:0.78rem;text-transform:uppercase">Topic / Chapter</span>
              <div style="font-weight:500;color:var(--text-primary);margin-top:0.2rem">
                <%= material.topic_name || 'General (No specific topic)' %>
              </div>
            </div>

            <div>
              <span style="color:var(--text-muted);font-size:0.78rem;text-transform:uppercase">Semester</span>
              <div style="color:var(--text-primary);margin-top:0.2rem">
                <%= material.subject_semester %>
              </div>
            </div>
          </div>
        </div>

        <!-- Uploader Info -->
        <div class="card">
          <div class="card-header">
            <h3>👤 Uploaded By</h3>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
            <div class="avatar avatar-md" style="font-weight:700">
              <%= material.uploader_name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <div style="font-weight:600;color:var(--text-heading)"><%= material.uploader_name %></div>
              <div style="font-size:0.8rem;color:var(--text-muted)">@<%= material.uploader_username %> · <%= material.uploader_student_code %></div>
            </div>
          </div>
          <div style="font-size:0.8rem;color:var(--text-muted);border-top:1px solid var(--border);padding-top:0.75rem">
            Original filename: <code><%= material.original_name %></code>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL: Edit Material Metadata (Owner / Admin) -->
    <% if (canEdit) { %>
      <div id="edit-material-modal" class="hidden" style="position:fixed;inset:0;background:rgba(0,0,0,0.75);display:flex;align-items:center;justify-content:center;z-index:999;padding:1rem">
        <div class="card" style="width:100%;max-width:580px;background:var(--bg-card);border:1px solid var(--border-light)">
          <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
            <h3>Edit Material Metadata</h3>
            <button class="btn btn-ghost btn-sm" onclick="document.getElementById('edit-material-modal').classList.add('hidden')">✕</button>
          </div>
          <form method="POST" action="/materials/<%= material.id %>/update">
            <div class="form-group">
              <label class="form-label" for="edit_mat_title">Title *</label>
              <input class="form-control" type="text" id="edit_mat_title" name="title" value="<%= material.title %>" required>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
              <div class="form-group">
                <label class="form-label" for="edit_mat_subject">Subject *</label>
                <select name="subject_id" id="edit_mat_subject" class="form-control" required onchange="loadTopicsForEdit(this.value)">
                  <% subjects.forEach(s => { %>
                    <option value="<%= s.id %>" <%= material.subject_id === s.id ? 'selected' : '' %>>
                      <%= s.code ? s.code + ' – ' : '' %><%= s.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="edit_mat_category">Category *</label>
                <select name="category" id="edit_mat_category" class="form-control" required>
                  <% categories.forEach(c => { %>
                    <option value="<%= c %>" <%= material.category === c ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="edit_mat_topic">Topic / Chapter</label>
              <select name="topic_id" id="edit_mat_topic" class="form-control">
                <option value="">General</option>
                <% topics.forEach(t => { %>
                  <option value="<%= t.id %>" <%= material.topic_id === t.id ? 'selected' : '' %>><%= t.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="edit_mat_desc">Description</label>
              <textarea class="form-control" id="edit_mat_desc" name="description" rows="3"><%= material.description || '' %></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" for="edit_mat_tags">Tags</label>
              <input class="form-control" type="text" id="edit_mat_tags" name="tags" value="<%= material.tags || '' %>">
            </div>
            <div style="display:flex;justify-content:flex-end;gap:0.75rem;margin-top:1rem">
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-material-modal').classList.add('hidden')">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Metadata</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>

  </main>
</div>

<script>
  async function loadTopicsForEdit(subjectId) {
    const topicSelect = document.getElementById('edit_mat_topic');
    topicSelect.innerHTML = '<option value="">General</option>';
    if (!subjectId) return;

    try {
      const resp = await fetch(`/subjects/${subjectId}/topics-json`);
      const data = await resp.json();
      if (data.success && data.topics) {
        data.topics.forEach(t => {
          const opt = document.createElement('option');
          opt.value = t.id;
          opt.textContent = t.name;
          topicSelect.appendChild(opt);
        });
      }
    } catch (e) {
      console.error(e);
    }
  }
</script>

<script src="/js/sidebar.js"></script>
<script src="/js/main.js"></script>
</body>
</html>

