<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1>My Profile</h1>
    </div>

    <div class="profile-grid">
      <div class="card profile-card">
        <div class="card-body">
          <div class="profile-avatar">
            <% if (profileUser.avatar_url) { %>
              <img src="<%= profileUser.avatar_url %>" alt="Avatar">
            <% } else { %>
              <span><%= profileUser.name ? profileUser.name.charAt(0).toUpperCase() : '?' %></span>
            <% } %>
          </div>
          <h2><%= profileUser.name %></h2>
          <p class="profile-email"><%= profileUser.email %></p>
          <span class="badge <%= profileUser.role === 'admin' ? 'badge-green' : 'badge-blue' %>"><%= profileUser.role %></span>
          <% if (profileUser.bio) { %><p class="profile-bio"><%= profileUser.bio %></p><% } %>
          <p class="profile-joined">Joined <%= new Date(profileUser.created_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2>Edit Profile</h2>
        </div>
        <div class="card-body">
          <form action="/profile" method="POST" enctype="multipart/form-data" class="auth-form">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" value="<%= profileUser.name %>" required>
            </div>
            <div class="form-group">
              <label for="bio">Bio</label>
              <textarea id="bio" name="bio" rows="3" placeholder="Tell us about yourself"><%= profileUser.bio || '' %></textarea>
            </div>
            <div class="form-group">
              <label for="avatar">Avatar</label>
              <input type="file" id="avatar" name="avatar" accept="image/*">
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2>Change Password</h2>
        </div>
        <div class="card-body">
          <form action="/profile/password" method="POST" class="auth-form">
            <div class="form-group">
              <label for="currentPassword">Current Password</label>
              <input type="password" id="currentPassword" name="currentPassword" required>
            </div>
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <input type="password" id="newPassword" name="newPassword" required minlength="6">
            </div>
            <div class="form-group">
              <label for="confirmPassword">Confirm New Password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" required>
            </div>
            <button type="submit" class="btn btn-primary">Change Password</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
