<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <h1>Settings</h1>
      <p class="page-subtitle">Manage application preferences</p>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>General Settings</h2>
      </div>
      <div class="card-body">
        <form action="/settings" method="POST" class="auth-form">
          <div class="form-group">
            <label for="siteName">Site Name</label>
            <input type="text" id="siteName" name="siteName" value="<%= settings.siteName || 'La Kazarma' %>">
          </div>
          <div class="form-group">
            <label for="siteDescription">Site Description</label>
            <textarea id="siteDescription" name="siteDescription" rows="3"><%= settings.siteDescription || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save Settings</button>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
