<%- include('../partials/head') %>
<%- include('../partials/mobile-nav') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <div class="page-header">
      <div>
        <h1>Assignments</h1>
        <p class="page-subtitle">All assignments across subjects</p>
      </div>
      <% if (user.role === 'admin') { %>
        <a href="/assignments/new" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Assignment
        </a>
      <% } %>
    </div>

    <% if (assignments.length === 0) { %>
      <div class="empty-state-card">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <h3>No assignments yet</h3>
        <p>Assignments will appear here once they are created.</p>
      </div>
    <% } else { %>
      <div class="assignments-list">
        <% assignments.forEach(function(a) { %>
          <a href="/assignments/<%= a.id %>" class="assignment-card">
            <div class="assignment-card-header">
              <div class="assignment-card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div>
                <h3><%= a.title %></h3>
                <span class="assignment-subject"><%= a.subject ? a.subject.name : '' %></span>
              </div>
            </div>
            <% if (a.description) { %><p class="assignment-desc"><%= a.description.substring(0, 120) %><% if (a.description.length > 120) { %>...<% } %></p><% } %>
            <div class="assignment-footer">
              <% if (a.due_date) { %>
                <span class="assignment-due <%= new Date(a.due_date) < new Date() ? 'overdue' : '' %>">
                  Due: <%= new Date(a.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </span>
              <% } else { %>
                <span class="assignment-due">No deadline</span>
              <% } %>
              <span>Max score: <%= a.max_score || 100 %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<script src="/js/sidebar.js"></script>
</body>
</html>
