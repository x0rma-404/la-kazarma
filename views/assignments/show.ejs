<%- include('../partials/head') %>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/mobile-nav') %>

  <main class="main-content">
    <%- include('../partials/flash') %>

    <!-- Back button & actions -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
      <div style="display:flex;gap:0.5rem;align-items:center">
        <a href="/assignments" class="btn btn-ghost btn-sm">← Back to Assignments</a>
        <a href="/subjects/<%= assignment.subject_id %>" class="btn btn-ghost btn-sm" style="color:var(--text-muted)">
          Subject: <%= assignment.subject_code || assignment.subject_name %>
        </a>
      </div>
      <% if (isOwner || isAdmin) { %>
        <form method="POST" action="/assignments/<%= assignment.id %>/delete" onsubmit="return confirm('Permanently delete assignment \'<%= assignment.title %>\'?')" style="margin:0">
          <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)">
            🗑 Delete Assignment
          </button>
        </form>
      <% } %>
    </div>

    <!-- Assignment Specification Workspace Card -->
    <div class="card" style="margin-bottom:1.5rem">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:1rem">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;flex-wrap:wrap">
            <span class="badge badge-admin"><%= assignment.subject_code ? assignment.subject_code + ' · ' : '' %><%= assignment.subject_name %></span>
            <% if (assignment.topic_name) { %>
              <span class="badge badge-student"><%= assignment.topic_name %></span>
            <% } %>
            <% if (assignment.deadline) { %>
              <% const isDueSoon = assignment.deadline >= Math.floor(Date.now()/1000); %>
              <span class="badge badge-<%= isDueSoon ? 'approved' : 'suspended' %>">
                <%= isDueSoon ? '⏳ Deadline: ' : '⚠️ Expired: ' %><%= new Date(assignment.deadline * 1000).toLocaleString('en-GB', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
              </span>
            <% } %>
          </div>

          <h1 style="font-size:1.6rem;margin:0 0 0.5rem;color:var(--text-heading)"><%= assignment.title %></h1>
          <div style="font-size:0.82rem;color:var(--text-muted)">
            Created by <strong><%= assignment.uploader_name %></strong> (<%= assignment.uploader_student_code %>) · <%= new Date(assignment.created_at * 1000).toLocaleDateString('en-GB') %>
          </div>
        </div>

        <!-- Download Original File Pill -->
        <% if (assignment.file_path) { %>
          <div style="background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:var(--radius);padding:0.75rem 1rem;display:flex;align-items:center;gap:0.75rem">
            <div>
              <span class="badge badge-outline" style="text-transform:uppercase;font-size:0.7rem;display:inline-block;margin-bottom:0.2rem">
                Original Task Document
              </span>
              <div style="font-size:0.875rem;font-weight:600;color:var(--text-heading)"><%= assignment.original_name %></div>
              <span style="font-size:0.75rem;color:var(--text-muted)"><%= formatBytes(assignment.file_size) %></span>
            </div>
            <a href="/assignments/<%= assignment.id %>/download" class="btn btn-primary btn-sm" style="display:inline-flex;align-items:center;gap:0.3rem">
              ⬇ Download
            </a>
          </div>
        <% } %>
      </div>

      <!-- Description / Instructions -->
      <% if (assignment.description) { %>
        <div style="background:rgba(255,255,255,0.015);padding:1rem;border-radius:var(--radius);border:1px solid var(--border);font-size:0.92rem;line-height:1.6;color:var(--text-primary);white-space:pre-wrap;margin-bottom:1rem">
          <%= assignment.description %>
        </div>
      <% } %>

      <% if (assignment.tags) { %>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap">
          <% assignment.tags.split(',').forEach(tag => { %>
            <% if (tag.trim()) { %>
              <span class="badge badge-student" style="font-size:0.75rem">#<%= tag.trim() %></span>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- 2 Columns: Submitted Solutions & Submit New Solution Form -->
    <div style="display:grid;grid-template-columns:1fr 380px;gap:1.5rem;align-items:start">
      <!-- Solutions List -->
      <div>
        <div class="card">
          <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
            <h3>💡 Peer Solutions (<%= solutions.length %>)</h3>
            <span style="font-size:0.8rem;color:var(--text-muted)">Independent student submissions</span>
          </div>

          <% if (solutions.length > 0) { %>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <% solutions.forEach(sol => { %>
                <div class="card" style="background:rgba(255,255,255,0.015);border:1px solid var(--border);padding:1rem">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:0.75rem">
                    <div style="display:flex;align-items:center;gap:0.6rem">
                      <div class="avatar avatar-sm" style="font-weight:700">
                        <%= sol.student_name.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <div style="font-weight:600;color:var(--text-heading);font-size:0.95rem">
                          <%= sol.title %>
                        </div>
                        <div style="font-size:0.78rem;color:var(--text-muted)">
                          Submitted by <strong><%= sol.student_name %></strong> (<%= sol.student_code %>) · <%= new Date(sol.created_at * 1000).toLocaleDateString('en-GB') %>
                        </div>
                      </div>
                    </div>

                    <div style="display:flex;gap:0.4rem;align-items:center">
                      <a href="/assignments/solutions/<%= sol.id %>/download" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:0.3rem">
                        ⬇ Solution (<%= formatBytes(sol.file_size) %>)
                      </a>
                      <% if (sol.student_id === currentUserId || isAdmin) { %>
                        <form method="POST" action="/assignments/<%= assignment.id %>/solutions/<%= sol.id %>/delete" onsubmit="return confirm('Delete this solution?')" style="margin:0">
                          <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)">✕</button>
                        </form>
                      <% } %>
                    </div>
                  </div>

                  <% if (sol.notes) { %>
                    <p style="margin:0.5rem 0 0;font-size:0.85rem;color:var(--text-secondary);line-height:1.5;white-space:pre-wrap;background:rgba(0,0,0,0.2);padding:0.6rem 0.75rem;border-radius:var(--radius)">
                      <%= sol.notes %>
                    </p>
                  <% } %>

                  <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.5rem">
                    File: <code><%= sol.original_name %></code> (<span style="text-transform:uppercase"><%= sol.file_type %></span>)
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div style="text-align:center;padding:2.5rem 1rem">
              <span style="font-size:2.5rem">💡</span>
              <p style="color:var(--text-muted);margin:0.75rem 0 0">No student solutions submitted yet. Be the first to share your approach!</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Submit Solution Form Card -->
      <div class="card" style="border-top:3px solid var(--accent)">
        <div class="card-header">
          <h3>Submit Your Solution</h3>
        </div>
        <p style="font-size:0.85rem;color:var(--text-muted);margin:-0.5rem 0 1rem;line-height:1.5">
          Share your solution, source code, report, or implementation. Multiple students can submit distinct solutions without overwriting each other.
        </p>

        <form method="POST" action="/assignments/<%= assignment.id %>/solutions" enctype="multipart/form-data">
          <div class="form-group">
            <label class="form-label" for="sol_title">Solution Title</label>
            <input class="form-control" type="text" id="sol_title" name="title" placeholder="e.g. <%= user.full_name %>'s Solution (C++ implementation)">
          </div>

          <div class="form-group">
            <label class="form-label">Solution File *</label>
            <input class="form-control" type="file" name="file" required>
            <div class="form-hint">Code file, PDF report, or ZIP archive (up to 50 MB)</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="sol_notes">Implementation Notes & Approach</label>
            <textarea class="form-control" id="sol_notes" name="notes" rows="3" placeholder="Explain your algorithm, edge cases handled, dependencies or instructions to run..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-full" style="justify-content:center">
            Upload Solution
          </button>
        </form>
      </div>
    </div>

  </main>
</div>

<script src="/js/sidebar.js"></script>
<script src="/js/main.js"></script>
</body>
</html>

