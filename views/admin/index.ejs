<%- include('../partials/head') %>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/mobile-nav') %>

  <main class="main-content">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <h1>⚙ Admin Panel</h1>
      <p>Manage members, approvals, and invitation codes.</p>
    </div>

    <!-- Tabs -->
    <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border);padding-bottom:0">
      <button class="btn btn-ghost" data-tab="users"
        style="border-bottom:2px solid transparent;border-radius:0;padding-bottom:0.75rem">
        👥 All Members (<%= allUsers.length %>)
      </button>
      <button class="btn btn-ghost" data-tab="pending"
        style="border-bottom:2px solid transparent;border-radius:0;padding-bottom:0.75rem">
        ⏳ Pending
        <% if (pending.length > 0) { %>
          <span class="badge badge-pending" style="margin-left:0.25rem"><%= pending.length %></span>
        <% } %>
      </button>
      <button class="btn btn-ghost" data-tab="codes"
        style="border-bottom:2px solid transparent;border-radius:0;padding-bottom:0.75rem">
        🎟 Invite Codes (<%= invCodes.length %>)
      </button>
      <button class="btn btn-ghost" data-tab="settings"
        style="border-bottom:2px solid transparent;border-radius:0;padding-bottom:0.75rem">
        ⚙ Settings & Policies
      </button>
    </div>

    <!-- Tab: All Members -->
    <div data-tab-panel="users" class="hidden">
      <div class="card" style="padding:0;overflow:hidden">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Member</th>
                <th>Student Code</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Joined</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% allUsers.forEach(function(u) { %>
                <tr id="user-row-<%= u.id %>">
                  <td>
                    <div style="display:flex;align-items:center;gap:0.6rem">
                      <div class="avatar avatar-sm"><%= u.full_name.charAt(0).toUpperCase() %></div>
                      <div>
                        <div style="font-weight:500"><%= u.full_name %></div>
                        <div style="font-size:0.78rem;color:var(--text-muted)">@<%= u.username %></div>
                      </div>
                    </div>
                  </td>
                  <td class="td-muted"><%= u.student_code %></td>
                  <td class="td-muted" style="font-size:0.82rem"><%= u.email %></td>
                  <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
                  <td><span class="badge badge-<%= u.status %>"><%= u.status %></span></td>
                  <td class="td-muted" style="font-size:0.8rem">
                    <%= new Date(u.created_at * 1000).toLocaleDateString('en-GB') %>
                  </td>
                  <td>
                    <% if (u.role !== 'admin') { %>
                      <div style="display:flex;gap:0.4rem;flex-wrap:wrap">
                        <% if (u.status === 'pending') { %>
                          <button class="btn btn-sm btn-primary" data-admin-action="approve" data-user-id="<%= u.id %>">Approve</button>
                          <button class="btn btn-sm btn-danger" data-admin-action="reject" data-user-id="<%= u.id %>">Reject</button>
                        <% } else if (u.status === 'approved') { %>
                          <button class="btn btn-sm btn-secondary" data-admin-action="suspend" data-user-id="<%= u.id %>"
                            data-confirm="Suspend @<%= u.username %>?">Suspend</button>
                        <% } else if (u.status === 'suspended' || u.status === 'rejected') { %>
                          <button class="btn btn-sm btn-primary" data-admin-action="reactivate" data-user-id="<%= u.id %>">Reactivate</button>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-muted" style="font-size:0.8rem">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
              <% if (allUsers.length === 0) { %>
                <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem">No members found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tab: Pending -->
    <div data-tab-panel="pending" class="hidden">
      <% if (pending.length === 0) { %>
        <div class="card" style="text-align:center;color:var(--text-muted);padding:3rem">
          <div style="font-size:2rem;margin-bottom:0.5rem">✓</div>
          No pending registrations. All caught up!
        </div>
      <% } else { %>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Member</th>
                  <th>Student Code</th>
                  <th>Email</th>
                  <th>Registered</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% pending.forEach(function(u) { %>
                  <tr id="pending-row-<%= u.id %>">
                    <td>
                      <div style="display:flex;align-items:center;gap:0.6rem">
                        <div class="avatar avatar-sm"><%= u.full_name.charAt(0).toUpperCase() %></div>
                        <div>
                          <div style="font-weight:500"><%= u.full_name %></div>
                          <div style="font-size:0.78rem;color:var(--text-muted)">@<%= u.username %></div>
                        </div>
                      </div>
                    </td>
                    <td class="td-muted"><%= u.student_code %></td>
                    <td class="td-muted" style="font-size:0.82rem"><%= u.email %></td>
                    <td class="td-muted" style="font-size:0.8rem">
                      <%= new Date(u.created_at * 1000).toLocaleDateString('en-GB') %>
                    </td>
                    <td>
                      <div style="display:flex;gap:0.4rem">
                        <button class="btn btn-sm btn-primary" data-admin-action="approve" data-user-id="<%= u.id %>">✓ Approve</button>
                        <button class="btn btn-sm btn-danger" data-admin-action="reject" data-user-id="<%= u.id %>">✕ Reject</button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Tab: Invitation Codes -->
    <div data-tab-panel="codes" class="hidden">
      <div style="display:flex;justify-content:flex-end;margin-bottom:1rem">
        <button class="btn btn-primary" data-admin-action="gen-code">
          + Generate New Code
        </button>
      </div>
      <div class="card" style="padding:0;overflow:hidden">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Code</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Expires</th>
                <th>Used By</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="inv-codes-tbody">
              <% invCodes.forEach(function(c) { %>
                <tr>
                  <td><code style="color:var(--accent-light);font-size:0.85rem"><%= c.code %></code></td>
                  <td class="td-muted"><%= c.created_by_username || '—' %></td>
                  <td class="td-muted" style="font-size:0.8rem">
                    <%= new Date(c.created_at * 1000).toLocaleDateString('en-GB') %>
                  </td>
                  <td class="td-muted" style="font-size:0.8rem">
                    <%= c.expires_at ? new Date(c.expires_at * 1000).toLocaleDateString('en-GB') : '—' %>
                  </td>
                  <td class="td-muted"><%= c.used_by_username || '—' %></td>
                  <td>
                    <% if (c.is_active && !c.used_by) { %>
                      <span class="badge badge-approved">Active</span>
                    <% } else if (c.used_by) { %>
                      <span class="badge badge-student">Used</span>
                    <% } else { %>
                      <span class="badge badge-suspended">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (c.is_active && !c.used_by) { %>
                      <button class="btn btn-sm btn-danger" data-admin-action="deactivate-code" data-code-id="<%= c.id %>"
                        data-confirm="Deactivate this code?">Deactivate</button>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
              <% if (invCodes.length === 0) { %>
                <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem">No codes generated yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tab: Platform Settings -->
    <div data-tab-panel="settings" class="hidden">
      <div class="card" style="max-width:680px">
        <div class="card-header">
          <h3>Platform & Material Policies</h3>
        </div>
        <p style="font-size:0.875rem;color:var(--text-muted);margin:-0.5rem 0 1.25rem">
          Configure global file constraints and content moderation rules for academic material sharing.
        </p>

        <form method="POST" action="/admin/settings">
          <div class="form-group">
            <label class="form-label" for="max_file_size_mb">Maximum File Size (MB)</label>
            <input class="form-control" type="number" id="max_file_size_mb" name="max_file_size_mb"
              value="<%= settings.max_file_size_mb || '50' %>" min="5" max="500" required>
            <div class="form-hint">Maximum payload limit per uploaded document or archive</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="allowed_file_types">Allowed File Extensions</label>
            <input class="form-control" type="text" id="allowed_file_types" name="allowed_file_types"
              value="<%= settings.allowed_file_types || 'pdf,doc,docx,ppt,pptx,xls,xlsx,txt,png,jpg,jpeg,webp,zip' %>" required>
            <div class="form-hint">Comma-separated lowercase extensions permitted on the platform</div>
          </div>

          <div class="form-group">
            <label style="display:flex;align-items:center;gap:0.6rem;cursor:pointer">
              <input type="checkbox" name="allow_zip_uploads" value="1" <%= settings.allow_zip_uploads === '1' ? 'checked' : '' %>>
              <span style="font-size:0.9rem;color:var(--text-primary);font-weight:500">Allow ZIP / Archive uploads</span>
            </label>
            <div class="form-hint" style="margin-left:1.6rem">Permits compressed coding projects and multi-file packages</div>
          </div>

          <div class="form-group">
            <label style="display:flex;align-items:center;gap:0.6rem;cursor:pointer">
              <input type="checkbox" name="content_moderation_enabled" value="1" <%= settings.content_moderation_enabled === '1' ? 'checked' : '' %>>
              <span style="font-size:0.9rem;color:var(--text-primary);font-weight:500">Enable Pre-publication Content Moderation</span>
            </label>
            <div class="form-hint" style="margin-left:1.6rem">When enabled, newly uploaded materials require admin approval before becoming visible to all students</div>
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:1.5rem">
            <button type="submit" class="btn btn-primary">Save Platform Settings</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script src="/js/sidebar.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
