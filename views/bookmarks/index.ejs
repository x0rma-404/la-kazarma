<%- include('../partials/head') %>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/mobile-nav') %>

  <main class="main-content">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <h1>🔖 My Bookmarked Materials</h1>
      <p>Quick access to your saved lecture slides, notes, assignments, and study references.</p>
    </div>

    <% if (bookmarks && bookmarks.length > 0) { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(320px, 1fr));gap:1.25rem">
        <% bookmarks.forEach(m => { %>
          <div class="card" style="display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
                <span class="badge badge-student" style="font-size:0.75rem"><%= m.category %></span>
                <span class="badge badge-outline" style="text-transform:uppercase;font-size:0.7rem"><%= m.file_type %></span>
              </div>

              <h3 style="font-size:1.1rem;margin:0 0 0.4rem">
                <a href="/materials/<%= m.id %>" style="color:var(--text-heading);text-decoration:none">
                  <%= m.title %>
                </a>
              </h3>

              <div style="font-size:0.8rem;color:var(--accent-light);font-weight:500;margin-bottom:0.5rem">
                <%= m.subject_code ? m.subject_code + ' · ' : '' %><%= m.subject_name %>
                <% if (m.topic_name) { %>
                  <span style="color:var(--text-muted)"> › <%= m.topic_name %></span>
                <% } %>
              </div>

              <% if (m.description) { %>
                <p style="color:var(--text-secondary);font-size:0.85rem;line-height:1.5;margin-bottom:0.75rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                  <%= m.description %>
                </p>
              <% } %>
            </div>

            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;color:var(--text-muted);padding-top:0.6rem;border-top:1px solid var(--border);margin-bottom:0.75rem">
                <span>By <%= m.uploader_name %></span>
                <span><%= formatBytes(m.file_size) %></span>
              </div>

              <div style="display:flex;gap:0.5rem">
                <a href="/materials/<%= m.id %>" class="btn btn-secondary btn-sm" style="flex:1;text-align:center">
                  View
                </a>
                <a href="/materials/<%= m.id %>/download" class="btn btn-primary btn-sm">
                  ⬇ Download
                </a>
                <form method="POST" action="/materials/<%= m.id %>/bookmark" style="margin:0">
                  <button type="submit" class="btn btn-ghost btn-sm" title="Remove bookmark" style="color:var(--danger)">
                    ✕
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;padding:3rem 1.5rem">
        <span style="font-size:3rem">🔖</span>
        <h3 style="margin-top:1rem;color:var(--text-heading)">No bookmarks yet</h3>
        <p style="color:var(--text-muted);max-width:400px;margin:0.5rem auto 1.5rem">
          You haven't bookmarked any materials yet. Click the bookmark icon on any material to save it here for fast revision.
        </p>
        <a href="/materials" class="btn btn-primary">Explore Study Materials</a>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/sidebar.js"></script>
<script src="/js/main.js"></script>
</body>
</html>

