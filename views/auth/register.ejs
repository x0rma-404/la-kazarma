<%- include('../partials/head', { extraCss: ['/css/auth.css'] }) %>
<body class="auth-page">
  <div class="auth-container">

    <!-- Emblem -->
    <div class="auth-emblem">
      <div class="auth-emblem-icon">⚔</div>
      <h1>La Kazarma de BHOS CE 25</h1>
      <p class="auth-subtitle">Create Your Account</p>
    </div>

    <!-- Flash -->
    <%- include('../partials/flash') %>

    <!-- Card -->
    <div class="auth-card">
      <h2 class="auth-card-title">Register</h2>
      <p class="auth-card-desc">Fill in your details to request access to the workspace.</p>

      <form method="POST" action="/register" autocomplete="off">

        <div class="form-group">
          <label class="form-label" for="full_name">Full Name</label>
          <input class="form-control" type="text" id="full_name" name="full_name"
            placeholder="e.g. Aytaj Mammadova" required autofocus>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="username">Username</label>
            <input class="form-control" type="text" id="username" name="username"
              placeholder="aytaj" pattern="[a-zA-Z0-9_]{3,20}" required>
            <span class="form-hint">3–20 chars, letters/numbers/underscore</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="student_code">Student Code</label>
            <input class="form-control" type="text" id="student_code" name="student_code"
              placeholder="CE25-001" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input class="form-control" type="email" id="email" name="email"
            placeholder="you@bhos.edu.az" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="invitation_code">Invitation Code</label>
          <input class="form-control" type="text" id="invitation_code" name="invitation_code"
            placeholder="BHOS-XXXX-XXXX" style="letter-spacing:0.05em">
          <span class="form-hint">Optional — but required for instant approval</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-control" type="password" id="password" name="password"
            placeholder="At least 8 characters" required minlength="8"
            autocomplete="new-password">
          <div class="password-strength">
            <div class="password-strength-bar" id="strength-bar"></div>
          </div>
          <span class="strength-label" id="strength-label"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="confirm_password">Confirm Password</label>
          <input class="form-control" type="password" id="confirm_password" name="confirm_password"
            placeholder="Repeat your password" required autocomplete="new-password">
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          Create Account
        </button>
      </form>

      <div class="auth-links" style="margin-top:1rem">
        Already have an account? <a href="/login">Sign In</a>
      </div>
    </div>

    <p class="auth-notice">Access restricted to BHOS CE25 members</p>
  </div>

  <script src="/js/sidebar.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
