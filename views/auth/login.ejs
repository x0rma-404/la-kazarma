<%- include('../partials/head', { extraCss: ['/css/auth.css'] }) %>
<body class="auth-page">
  <div class="auth-container">

    <!-- Emblem -->
    <div class="auth-emblem">
      <div class="auth-emblem-icon">⚔</div>
      <h1>La Kazarma de BHOS CE 25</h1>
      <p class="auth-subtitle">Private Academic Workspace</p>
    </div>

    <!-- Flash -->
    <%- include('../partials/flash') %>

    <!-- Card -->
    <div class="auth-card">
      <h2 class="auth-card-title">Sign In</h2>
      <p class="auth-card-desc">Enter your credentials to access the workspace.</p>

      <form method="POST" action="/login" autocomplete="on">
        <div class="form-group">
          <label class="form-label" for="identifier">Username or Student Code</label>
          <input
            class="form-control"
            type="text"
            id="identifier"
            name="identifier"
            placeholder="e.g. johndoe or CE25-001"
            autocomplete="username"
            required
            autofocus
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input
            class="form-control"
            type="password"
            id="password-login"
            name="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          >
        </div>

        <div class="form-group flex items-center justify-between">
          <label class="checkbox-label">
            <input type="checkbox" name="remember" value="1">
            Remember me
          </label>
          <a href="/forgot-password" style="font-size:0.85rem">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          Sign In
        </button>
      </form>

      <div class="auth-divider">or</div>

      <div class="auth-links">
        Don't have an account? <a href="/register">Register</a>
      </div>
    </div>

    <p class="auth-notice">Access restricted to BHOS CE25 members</p>
  </div>

  <script src="/js/sidebar.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
